# ── Palkay Environment Variables ─────────────────────────────────────────────
# Copy to .env — NEVER commit .env to version control.

# ── Django Core ──────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-minimum-50-characters
DEBUG=False
ALLOWED_HOSTS=palkay.com,www.palkay.com
DJANGO_SETTINGS_MODULE=palkay.settings_production
ADMIN_URL=secure-admin-xyz/

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://palkay_user:strongpassword@localhost:5432/palkay_db
DISABLE_SERVER_SIDE_CURSORS=False

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=Palkay <noreply@palkay.com>
SERVER_EMAIL=errors@palkay.com

# ── S3 Media Storage ──────────────────────────────────────────────────────────
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=palkay-media
# AWS_S3_REGION_NAME=us-east-1

# ── Cloudflare ────────────────────────────────────────────────────────────────
TRUST_CLOUDFLARE=True
CLOUDFLARE_ONLY=False
# CF_API_TOKEN=
# CF_ZONE_ID=
# CF_ACCOUNT_ID=
# DOMAIN=palkay.com
# ORIGIN_IP=your.server.ip.address
